<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.rub.nds</groupId>
        <artifactId>protocol-toolkit-bom</artifactId>
        <version>4.0.2</version>
    </parent>

    <groupId>de.rub.nds.ssh.statelearner</groupId>
    <artifactId>ssh-state-learner</artifactId>
    <version>0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>SSH State Learner</name>
    <url>https://github.com/tlsattacker/SSH-State-Learner</url>
    <inceptionYear>2021</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <modules>
        <module>android</module>
        <module>core</module>
        <module>environment</module>
    </modules>

    <scm>
        <connection>scm:git:https://github.com/tls-attacker/SSH-State-Learner.git</connection>
        <developerConnection>scm:git:ssh://github.com/tls-attacker/SSH-State-Learner.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/tls-attacker/SSH-State-Learner</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <kotlin.version>1.9.21</kotlin.version>
        <ssh.core.version>1.3.1-SNAPSHOT</ssh.core.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>de.rub.nds.ssh.attacker</groupId>
                <artifactId>ssh-core</artifactId>
                <version>${ssh.core.version}</version>
            </dependency>
            <dependency>
                <groupId>de.rub.nds.ssh.attacker</groupId>
                <artifactId>ssh-core-oqs</artifactId>
                <version>${ssh.core.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
